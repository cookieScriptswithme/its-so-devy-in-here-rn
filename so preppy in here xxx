local themeButtons = {}

local function applyTheme(index)
    if index == nil then
        bg.Image = ""
        bg.ImageTransparency = 1
        for _, b in ipairs(themeButtons) do b.BackgroundColor3 = BLUE end
        return
    end
    local theme = THEMES[index]
    if not theme then return end
    bg.Image = themeImg(theme.id)
    bg.ImageTransparency = 0
    for i, b in ipairs(themeButtons) do
        if i == index then b.BackgroundColor3 = BLUE_DARK else b.BackgroundColor3 = BLUE end
    end
end

