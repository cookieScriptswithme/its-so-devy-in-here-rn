local function updateFog(v)
    fogValue = math.clamp(v, 0, fogMax)
    fogInput.Text = tostring(math.floor(fogValue))
    local pct = fogValue / fogMax
    sliderFill.Size = UDim2.new(pct, 0, 1, 0)
    sliderKnob.Position = UDim2.new(pct, -9, 0.5, -9)
end

